# Copy to .env in the repo root. Real environment variables always win over these.
# All of these are optional — Hermes degrades gracefully without any of them.

# Overrides config.yaml's ollama_host. Set this on a Qubes client VM to the Ollama VM's
# internal IP, e.g. http://10.137.0.15:11434 — see docs/qubes-deployment.md.
# OLLAMA_HOST=http://127.0.0.1:11434

# For full GitHub integration (PRs/issues) when the `gh` CLI isn't installed.
# GITHUB_TOKEN=

# Free key from https://nvd.nist.gov/developers/request-an-api-key — bumps NVD's rate
# limit from 5 to 50 requests/30s. CVE lookups work without it, just slower under load.
# NVD_API_KEY=

# Free key from https://auth.abuse.ch/ — required for MalwareBazaar sample-intel lookups
# (mandatory Auth-Key since June 2025; without it, malware_bazaar_tool reports itself
# as unconfigured instead of failing).
# MALWAREBAZAAR_AUTH_KEY=

# Overrides the "default" model role from config.yaml.
# HERMES_MODEL=

# Blanket auto-confirm for shell_exec — off by default, this is your own authorized
# pentest/malware-dev environment but you probably still want to see risky commands first.
# HERMES_SHELL_AUTO_CONFIRM=false

# WhatsApp channel (bin/miku-whatsapp) — your main number, digits + country code only,
# no + or spaces, e.g. 15551234567. Empty/unset = the bridge rejects everyone.
# WHATSAPP_ALLOWED_USERS=
